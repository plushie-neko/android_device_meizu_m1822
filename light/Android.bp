cc_binary {
    name: "android.hardware.light-service.meizu_m1822",
    defaults: ["hidl_defaults"],
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.light-service.meizu_m1822.rc"],
    vintf_fragments: ["android.hardware.light-service.meizu_m1822.xml"],
    srcs: [
        "Lights.cpp",
	"service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.light-V2-ndk",
    ],
}
